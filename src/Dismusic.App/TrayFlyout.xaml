<Window x:Class="Dismusic.App.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Dismusic.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Dismusic quick controls" Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True">
    <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,14,16,12">
        <StackPanel>
            <!-- Volume of the current default output -->
            <TextBlock Text="Volume" Style="{StaticResource ColumnHeader}" />
            <TextBlock Text="{Binding DefaultOutput.Name}" Style="{StaticResource Hint}" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,6" />
            <DockPanel DataContext="{Binding DefaultOutput}" Margin="0,0,0,14"
                       Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <ToggleButton x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource IconToggle}"
                              IsChecked="{Binding IsMuted}" Content="{Binding Glyph}"
                              AutomationProperties.Name="{Binding MuteAutomationName}" ToolTip="Mute or unmute" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="40" Margin="10,0,0,0" TextAlignment="Right">
                    <Run Text="{Binding Volume, Mode=OneWay}" /><Run Text="%" />
                </TextBlock>
                <Slider x:Name="VolumeSlider" VerticalAlignment="Center" Margin="8,0,0,0" Minimum="0" Maximum="100"
                        SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Volume}" AutomationProperties.Name="{Binding VolumeAutomationName}" />
            </DockPanel>

            <!-- Output switch -->
            <TextBlock Text="Output" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding OutputDevices}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                        <RadioButton GroupName="DismusicOutput" Margin="0,2"
                                     IsChecked="{Binding IsDefault, Mode=OneWay}" Checked="OnOutputChecked"
                                     AutomationProperties.Name="{Binding Name, StringFormat=Use {0} as the output}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,12,0,8" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="12"
                           Text="Sets the Windows default" />
                <Button HorizontalAlignment="Right" Content="Open Dismusic" Click="OnOpenClick" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
