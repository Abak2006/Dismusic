<ui:FluentWindow x:Class="Dismusic.App.TrayFlyout"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Dismusic.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Dismusic quick controls" Width="340" MinWidth="340" MaxWidth="340" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="16,14,16,12">
        <!-- Volume of the current default output -->
        <DockPanel Margin="0,0,0,2">
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Speaker224" Margin="0,0,8,0" />
            <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding DefaultOutput.Name}" Style="{StaticResource Caption}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,8" />
        <DockPanel DataContext="{Binding DefaultOutput}" Margin="0,0,0,14"
                   Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
            <ToggleButton x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource IconToggle}"
                          IsChecked="{Binding IsMuted}" Content="{Binding Glyph}"
                          AutomationProperties.Name="{Binding MuteAutomationName}" ToolTip="Mute or unmute" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="40" Margin="10,0,0,0" TextAlignment="Right" FontSize="13">
                <Run Text="{Binding Volume, Mode=OneWay}" /><Run Text="%" />
            </TextBlock>
            <Slider x:Name="VolumeSlider" VerticalAlignment="Center" Margin="10,0,0,0" Minimum="0" Maximum="100"
                    SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Volume}" AutomationProperties.Name="{Binding VolumeAutomationName}" />
        </DockPanel>

        <!-- Output switch -->
        <DockPanel Margin="0,0,0,6">
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="SpeakerSettings24" Margin="0,0,8,0" />
            <TextBlock Text="Output" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding OutputDevices}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                    <RadioButton GroupName="DismusicOutput" Margin="0,1"
                                 IsChecked="{Binding IsDefault, Mode=OneWay}" Checked="OnOutputChecked"
                                 AutomationProperties.Name="{Binding Name, StringFormat=Use {0} as the output}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" />
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,12,0,10" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Sets the Windows default" />
            <ui:Button HorizontalAlignment="Right" Content="Open Dismusic" Icon="{ui:SymbolIcon Open24}" Click="OnOpenClick" />
        </DockPanel>
    </StackPanel>
</ui:FluentWindow>
