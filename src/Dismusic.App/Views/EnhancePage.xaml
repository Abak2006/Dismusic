<Page x:Class="Dismusic.App.Views.EnhancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Dismusic.App.ViewModels"
      mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:EnhanceViewModel}"
      Title="Enhance" ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Enhance" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,2,0,12"
                   Text="Boost an app beyond 100% and shape it with a 10-band equalizer. Your last choice is remembered and used for the next app you enhance." />

        <ui:InfoBar Grid.Row="2" Message="{Binding StatusText}" Severity="Informational"
                    IsOpen="{Binding IsStatusOpen, Mode=TwoWay}" Margin="0,0,0,8" />

        <!-- Split workspace: app list | editor -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Row}" Padding="4" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Apps" Style="{StaticResource ColumnHeader}" Margin="10,6,0,6" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="10,4,10,8"
                               Visibility="{Binding HasApps, Converter={StaticResource BoolToCollapsed}}"
                               Text="No apps are playing audio right now. Start playback and the app appears here." />
                    <ui:ListView ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Apps to enhance" HorizontalContentAlignment="Stretch">
                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ui:ListView.ItemContainerStyle>
                        <ui:ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EnhanceAppViewModel}">
                                <DockPanel Margin="0,2">
                                    <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding Enabled}"
                                                     Margin="8,0,0,0" AutomationProperties.Name="{Binding EnableAutomationName}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Row}" Padding="20,14" Margin="0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Selected}">
                            <DockPanel Margin="0,0,0,14">
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding Enabled}"
                                                 OnContent="Enhanced" OffContent="Off"
                                                 AutomationProperties.Name="{Binding EnableAutomationName}" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" MaxWidth="340" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Content="_Preset" Target="{Binding ElementName=PresetBox}" VerticalAlignment="Center" Padding="0" />
                                <ComboBox x:Name="PresetBox" Grid.Column="1"
                                          ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding PresetKey}" />
                                <Label Grid.Row="2" Content="_Volume" Target="{Binding ElementName=BoostSlider}" VerticalAlignment="Center" Padding="0" />
                                <Slider x:Name="BoostSlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                        Minimum="0" Maximum="400" SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding VolumePercent}" AutomationProperties.Name="Volume percent"
                                        AutomationProperties.HelpText="Above 100 boosts the app." />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="44" FontSize="13">
                                    <Run Text="{Binding VolumePercent, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Equalizer (dB)" Style="{StaticResource ColumnHeader}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Bands}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" HorizontalAlignment="Left" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BandViewModel}">
                                        <StackPanel Width="46" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding GainText}" HorizontalAlignment="Center" FontSize="12" />
                                            <Slider Orientation="Vertical" Height="140" HorizontalAlignment="Center" Margin="0,4"
                                                    Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="3"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                    Value="{Binding Gain}" AutomationProperties.Name="{Binding AutomationName}" />
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <ui:Button Content="Reset to flat" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetCommand}" Margin="0,0,8,8" />
                            <ui:TextBox Width="170" PlaceholderText="New preset name" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,8,8" AutomationProperties.Name="New preset name" />
                            <ui:Button Content="Save as preset" Icon="{ui:SymbolIcon Save24}" Command="{Binding SavePresetCommand}" Margin="0,0,8,8" />
                            <ui:Button Content="Delete preset" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeletePresetCommand}" Margin="0,0,0,8"
                                       ToolTip="Delete the selected preset (only presets you made)" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   Text="No driver needed: Dismusic turns the app down to 0% in Windows (-48 dB), captures it, restores the original exactly, applies your settings and plays it ~50–60 ms later. Volumes are restored when you turn it off or quit." />
    </Grid>
</Page>
