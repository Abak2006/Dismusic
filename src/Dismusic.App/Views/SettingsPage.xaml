<Page x:Class="Dismusic.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Dismusic.App.ViewModels"
      mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
      Title="Settings" ScrollViewer.CanContentScroll="False"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Startup" Style="{StaticResource ColumnHeader}" Margin="2,0,0,6" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"
                                         AutomationProperties.Name="Start with Windows" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Power24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Opens in the notification area at sign-in, so routing and the enhancements you last chose apply as soon as apps play." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center"
                                         AutomationProperties.Name="Start minimized" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowMinimize24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Always start minimized" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Also when you open Dismusic yourself. Click the tray icon for quick controls." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Maintenance" Style="{StaticResource ColumnHeader}" Margin="2,16,0,6" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Reset…" Command="{Binding ResetAllRoutesCommand}" VerticalAlignment="Center" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowReset24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Reset all app outputs" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Removes every per-app output choice on this PC, including ones made in Windows Settings." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Open" Icon="{ui:SymbolIcon OpenFolder24}" Command="{Binding OpenLogFolderCommand}" VerticalAlignment="Center" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="DocumentText24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Log folder" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Useful when something doesn't work as expected." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Keyboard" Style="{StaticResource ColumnHeader}" Margin="2,16,0,6" />
                <Border Style="{StaticResource Row}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ctrl+1 … Ctrl+5" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="Apps, Multi-output, Enhance, Screens, Settings" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Row="1" Text="F5" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Refresh devices and apps now" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Text="Ctrl+W" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Close to the notification area (Dismusic keeps running)" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Text="Esc" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Close the tray quick controls" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <TextBlock Text="About" Style="{StaticResource ColumnHeader}" Margin="2,16,0,6" />
                <Border Style="{StaticResource Row}">
                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Style="{StaticResource RowTitle}">
                            <Run Text="Dismusic " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="Settings: " /><Run Text="{Binding SettingsPath, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="Quit from the tray icon's menu (Exit). Closing the window keeps routing running." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
